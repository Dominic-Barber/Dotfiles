autogenerated = 0
$mainMod = SUPER
$terminal = ghostty
$fileManager = dolphin

# Standard App Binds
bind = $mainMod, Q, exec, $terminal
bind = $mainMod, W, killactive,
bind = $mainMod, M, exec, command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch exit
bind = $mainMod, E, exec, $fileManager
bind = $mainMod, F, togglefloating,

# -----------------------------------------------------
# Noctalia IPC Binds (Replaces your old menus/daemons)
# -----------------------------------------------------
bind = $mainMod, R, exec, qs -c noctalia-shell ipc call launcher toggle
bind = $mainMod, N, exec, qs -c noctalia-shell ipc call panel-toggle notifications
bind = $mainMod, L, exec, qs -c noctalia-shell ipc call lockScreen lock

# Clipboard
bind = $mainMod, V, exec, cliphist list | wofi --dmenu | cliphist decode | wl-copy

# Window Management (Fixed 'mose' typo on resize)
bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow
bindm = $mainMod SHIFT, left, movewindow
bindm = $mainMod ALT, left, resizewindow
bind = $mainMod SHIFT, right, resizeactive, 10 0
bind = $mainMod SHIFT, left, resizeactive, -10 0
bind = $mainMod SHIFT, up, resizeactive, 0 -10
bind = $mainMod SHIFT, down, resizeactive, 0 10

# -----------------------------------------------------
# Startup Services
# -----------------------------------------------------
exec-once = systemctl --user start hyprpolkitagent
exec-once = wl-paste --type text --watch cliphist store 
exec-once = wl-paste --type image --watch cliphist store

# Launch Noctalia Shell
exec-once = qs -c noctalia-shell

xwayland {
    force_zero_scaling = true
}
